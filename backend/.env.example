# ==========================================
# MEDINTEL Environment Configuration
# ==========================================

# --- NVIDIA NIM API (Primary Multi-Agent LLM Engine) ---
# Obtain free developer credits at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Google Gemini API (Fallback Multi-Agent LLM Engine) ---
# Obtain API key at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-key-here

# --- NCBI PubMed API (Optional - enhances rate limits for PubMed queries) ---
# Obtain from NCBI account settings
NCBI_API_KEY=

# --- Multi-Agent Model Routing Lineup ---
ORCHESTRATOR_MODEL=meta/llama-3.1-70b-instruct
VISION_ANALYST_MODEL=microsoft/phi-3-vision-128k-instruct
RESEARCHER_MODEL=mistralai/mixtral-8x22b-instruct
VERIFIER_MODEL=meta/llama-3.1-70b-instruct
FALLBACK_MODEL=gemini-1.5-flash

# --- Hardware Watchdog ---
# Maximum RAM budget before triggering Python garbage collection (in MB)
MAX_MEMORY_MB=450
